# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Environments and local configuration
.venv/
venv/
env/
.env
.env.*
!.env.example

# Packaging
build/
dist/
*.egg-info/
.eggs/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Legacy dataset location: V1 remains available from its tag
/datasets/
/results/

# V2 data policy
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/samples/*
!data/samples/.gitkeep

# Generated experiment output
runs/*
!runs/.gitkeep

# Model weights and exports
/weights/
/models/
*.pt
*.pth
*.onnx
*.engine
*.torchscript
*.tflite
*.mlpackage
*_openvino_model/
*_saved_model/

# Local videos and dashboard uploads
*.mp4
*.avi
*.mov
*.mkv
uploads/
